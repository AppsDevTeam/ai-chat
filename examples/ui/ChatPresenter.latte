{* The page shell: the frontend needs jQuery plus the three CDN libraries below
   (charts, markdown rendering, HTML sanitization) and the two assets from
   examples/ui/assets/. In a @layout-based project put the includes in the layout
   blocks instead. *}
{block styles}
	<link rel="stylesheet" href="/css/ai-chat.css">
{/block}

{block content}
	{control chat}
{/block}

{block scripts}
	<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/dompurify@3.2.4/dist/purify.min.js"></script>
	<script src="/js/aiChatControl.js"></script>
{/block}
