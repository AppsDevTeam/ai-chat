{* The widget builds its own markup into the root element. Bundle the assets with
   your build (Vite, webpack, ...):

     import { mountAll } from 'adt-ai-chat';
     import 'adt-ai-chat/ai-chat.css';
     import { marked } from 'marked';
     import DOMPurify from 'dompurify';
     import Chart from 'chart.js/auto';

     mountAll(document, { marked, DOMPurify, Chart });
*}
{block content}
	<div data-ai-chat="{json_encode($config)}"></div>
{/block}
