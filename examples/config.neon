# Complete Nette DI wiring of the chat. Symfony users: the same services, just
# registered in services.yaml.

services:
	# 1. Transport to the Managed Agents API.
	- ADT\AiChat\Client\GuzzleManagedAgentsClient(
		apiKey: %env.ANTHROPIC_API_KEY%
		model: claude-sonnet-5-5
	)

	# 2. Read-only access to the anonymized schema (adt/doctrine-anonymization).
	#    The user MUST be a dedicated account with SELECT on the anon schema only.
	- ADT\DoctrineAnonymization\AnonymizationPolicy
	- ADT\DoctrineAnonymization\SchemaDescriber
	- ADT\DoctrineAnonymization\PersonalDataColumns
	- ADT\DoctrineAnonymization\AnonymizedViewsGenerator
	- ADT\DoctrineAnonymization\ReadOnlyConnectionOptions(
		user: %env.DB_ANON_USER%
		password: %env.DB_ANON_PASSWORD%
	)
	- ADT\DoctrineAnonymization\ReadOnlyQueryExecutor

	# 3. The engine.
	- ADT\AiChat\ToolHandler
	- ADT\AiChat\PiiValueCollector
	- ADT\AiChat\PiiResponseFilter          # pass labels for a localized chat
	- ADT\AiChat\SystemPromptBuilder(
		templatePath: %appDir%/ai-chat/system-prompt.md   # copy the default from the package
	)
	- ADT\AiChat\AgentProvisioner(
		agentClass: App\AiChat\Entity\Agent
		namePrefix: myapp-aichat
	)

	# 4. The coordinator over your entities, the hand-off to the queue and the
	#    HTTP side of the widget.
	- ADT\AiChat\ChatOptions(
		conversationClass: App\AiChat\Entity\Conversation
		messageClass: App\AiChat\Entity\Message
		ownerField: user
	)
	- ADT\AiChat\Dispatch\BackgroundQueueMessageDispatcher
	aiChat.service:
		factory: ADT\AiChat\ChatService
		# optional: localize the user-facing errors (keys aiChat.error.*)
		setup:
			- setTranslator([@App\AiChat\Ui\ChatTranslator, translate])
	- ADT\AiChat\Http\ChatEndpoint

	- App\AiChat\Ui\ChatTranslator

# adt/background-queue: the worker runs the turn.
backgroundQueue:
	callbacks:
		aiChatProcessMessage: [@aiChat.service, processQueuedMessage]
